{
  "enabled": true,
  "platforms": ["linkedin", "indeed", "seek"],
  "executionMode": "sequential",
  "postedWithinDays": 7,
  "exclusionKeywords": ["expression of interest", "eoi"],
  "workerTiming": {
    "accessLimit": 20,
    "cooldownMinutes": 5,
    "actionDelaySeconds": 1,
    "scrollDelaySeconds": 2,
    "pageDelaySeconds": 10,
    "jdIntervalSeconds": 1,
    "jdRequestTimeoutSeconds": 5,
    "jdPageTimeoutSeconds": 10
  },
  "coverLetter": {
    "maxPages": 1,
    "prompt": "Write a tailored professional cover letter from this profile and job description. Use a natural, low-AI tone, concrete evidence, and STAR logic without labeling STAR sections. Never invent experience or qualifications."
  },
  "locations": [
    { "id": "melbourne-vic", "name": "Melbourne VIC", "enabled": true },
    { "id": "australia", "name": "Australia", "enabled": false },
    { "id": "sydney-nsw", "name": "Sydney NSW", "enabled": false },
    { "id": "brisbane-qld", "name": "Brisbane QLD", "enabled": false },
    { "id": "perth-wa", "name": "Perth WA", "enabled": false }
  ],
  "searches": [
    { "id": "graduate-software", "keyword": "graduate software engineer", "enabled": true, "priority": 100 },
    { "id": "graduate-developer", "keyword": "graduate software developer", "enabled": true, "priority": 95 },
    { "id": "graduate-technology", "keyword": "graduate technology", "enabled": true, "priority": 90 },
    { "id": "graduate-data", "keyword": "graduate data analyst", "enabled": true, "priority": 90 },
    { "id": "graduate-ai", "keyword": "graduate AI", "enabled": true, "priority": 90 },
    { "id": "software-intern", "keyword": "software engineer intern", "enabled": true, "priority": 85 },
    { "id": "machine-learning-intern", "keyword": "machine learning intern", "enabled": true, "priority": 85 },
    { "id": "data-intern", "keyword": "data science intern", "enabled": true, "priority": 80 }
  ],
  "thresholds": {
    "strongMatch": 85,
    "goodMatch": 70,
    "maybe": 50,
    "lowMatch": 30
  }
}
