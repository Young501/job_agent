# Optional OpenAI-compatible endpoint. Leave all variables unset for local-only
# profile drafts and rule-based JD screening.
JOB_AGENT_AI_BASE_URL=http://127.0.0.1:11434/v1
JOB_AGENT_AI_MODEL=your-model-name
JOB_AGENT_AI_API_KEY=
JOB_AGENT_AI_WIRE_API=chat_completions

# Cost controls. Title screening never calls AI. AI is used only for profile
# drafting and ambiguous-role JD review.
JOB_AGENT_AI_REASONING_EFFORT=low
JOB_AGENT_AI_MAX_INPUT_CHARS=18000
JOB_AGENT_AI_MAX_PROFILE_OUTPUT_TOKENS=550
JOB_AGENT_AI_MAX_JD_OUTPUT_TOKENS=350
JOB_AGENT_AI_MAX_JD_REVIEWS_PER_RUN=20
JOB_AGENT_AI_MAX_CALLS_PER_RUN=24

# Optional override when Python is not available on PATH. It is used only to
# extract text from uploaded .docx and PDF resumes.
JOB_AGENT_PYTHON_PATH=python
